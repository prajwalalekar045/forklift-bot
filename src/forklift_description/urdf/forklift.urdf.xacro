<?xml version="1.0"?>
<!--
  Differential-drive forklift for Ignition Gazebo Fortress (`ign gazebo`) and ROS 2 Humble.
  Frames: base_footprint -> base_link -> wheels, caster, lidar, camera, imu, mast -> carriage (prismatic, z) -> forks.
  The robot faces +x. Forks extend forward from the carriage.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="forklift">

  <!-- Dimensions (m) -->
  <xacro:property name="body_l" value="0.80"/>
  <xacro:property name="body_w" value="0.50"/>
  <xacro:property name="body_h" value="0.20"/>
  <xacro:property name="body_m" value="20.0"/>
  <xacro:property name="wheel_r" value="0.10"/>
  <xacro:property name="wheel_w" value="0.05"/>
  <xacro:property name="wheel_m" value="1.5"/>
  <xacro:property name="wheel_sep" value="0.56"/>
  <xacro:property name="wheel_x" value="-0.10"/>
  <xacro:property name="mast_x" value="0.42"/>
  <xacro:property name="mast_h" value="0.90"/>
  <xacro:property name="fork_len" value="0.60"/>
  <xacro:property name="fork_lift_max" value="0.60"/>

  <!-- Box inertia helper -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <material name="body_yellow"><color rgba="1.00 0.76 0.00 1"/></material>
  <material name="dark"><color rgba="0.12 0.14 0.16 1"/></material>
  <material name="steel"><color rgba="0.55 0.58 0.60 1"/></material>
  <material name="black"><color rgba="0.04 0.04 0.05 1"/></material>
  <material name="graphite"><color rgba="0.20 0.21 0.23 1"/></material>
  <material name="chrome"><color rgba="0.80 0.82 0.85 1"/></material>
  <material name="red"><color rgba="0.85 0.08 0.08 1"/></material>
  <material name="orange"><color rgba="1.00 0.42 0.00 1"/></material>
  <material name="lamp"><color rgba="0.98 0.98 0.90 1"/></material>
  <material name="amber"><color rgba="1.00 0.56 0.00 1"/></material>
  <material name="safety_blue"><color rgba="0.05 0.35 1.00 1"/></material>
  <material name="signal_green"><color rgba="0.10 0.75 0.25 1"/></material>
  <material name="white"><color rgba="0.92 0.93 0.94 1"/></material>
  <material name="copper"><color rgba="0.72 0.45 0.20 1"/></material>

  <!-- Visual-only helpers: no collision, no mass. Decoration must not change the physics. -->
  <xacro:macro name="vbox" params="n xyz size mat rpy:='0 0 0'">
    <visual name="${n}">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
      <material name="${mat}"/>
    </visual>
  </xacro:macro>
  <xacro:macro name="vcyl" params="n xyz r l mat rpy:='0 0 0'">
    <visual name="${n}">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${r}" length="${l}"/></geometry>
      <material name="${mat}"/>
    </visual>
  </xacro:macro>
  <xacro:macro name="vsph" params="n xyz r mat">
    <visual name="${n}">
      <origin xyz="${xyz}"/>
      <geometry><sphere radius="${r}"/></geometry>
      <material name="${mat}"/>
    </visual>
  </xacro:macro>

  <!-- Base -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="body_yellow"/>
    </visual>
    <collision>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <xacro:box_inertia m="${body_m}" x="${body_l}" y="${body_w}" z="${body_h}"/>

    <!-- ===== Industrial look (visual only). Everything on the body stays below z=+0.20 (the lidar
         plane is +0.22) except thin posts, which scan_filter.yaml removes as part of the robot. ===== -->
    <!-- black skirt and chassis rails -->
    <xacro:vbox n="skirt" xyz="0 0 -0.085" size="0.82 0.52 0.03" mat="graphite"/>
    <xacro:vbox n="side_panel_l" xyz="-0.02 0.2505 0.0" size="0.50 0.002 0.12" mat="graphite"/>
    <xacro:vbox n="side_panel_r" xyz="-0.02 -0.2505 0.0" size="0.50 0.002 0.12" mat="graphite"/>
    <xacro:vbox n="vent_l" xyz="-0.02 0.2515 0.0" size="0.30 0.001 0.04" mat="black"/>
    <xacro:vbox n="vent_r" xyz="-0.02 -0.2515 0.0" size="0.30 0.001 0.04" mat="black"/>
    <!-- wheel arches (flat covers over the drive wheels) -->
    <xacro:vbox n="fender_l" xyz="-0.10 0.2775 0.0" size="0.28 0.055 0.012" mat="body_yellow" rpy="0 0 0"/>
    <xacro:vbox n="fender_r" xyz="-0.10 -0.2775 0.0" size="0.28 0.055 0.012" mat="body_yellow" rpy="0 0 0"/>
    <!-- counterweight at the rear: top at +0.20 so the lidar (on top of it) sees over it -->
    <xacro:vbox n="counterweight" xyz="-0.30 0 0.15" size="0.20 0.50 0.10" mat="body_yellow"/>
    <xacro:vbox n="cw_cap" xyz="-0.30 0 0.203" size="0.20 0.50 0.006" mat="graphite"/>
    <xacro:vbox n="stripe_1" xyz="-0.402 0.205 0.15" size="0.004 0.05 0.10" mat="black"/>
    <xacro:vbox n="stripe_2" xyz="-0.402 0.105 0.15" size="0.004 0.05 0.10" mat="black"/>
    <xacro:vbox n="stripe_3" xyz="-0.402 0.005 0.15" size="0.004 0.05 0.10" mat="black"/>
    <xacro:vbox n="stripe_4" xyz="-0.402 -0.095 0.15" size="0.004 0.05 0.10" mat="black"/>
    <xacro:vbox n="stripe_5" xyz="-0.402 -0.195 0.15" size="0.004 0.05 0.10" mat="black"/>
    <xacro:vbox n="tail_l" xyz="-0.402 0.235 0.19" size="0.004 0.03 0.02" mat="red"/>
    <xacro:vbox n="tail_r" xyz="-0.402 -0.235 0.19" size="0.004 0.03 0.02" mat="red"/>
    <!-- front bumper with hazard stripes and headlights (below the forks) -->
    <xacro:vbox n="bumper" xyz="0.415 0 -0.03" size="0.03 0.52 0.07" mat="black"/>
    <xacro:vbox n="bump_s1" xyz="0.4305 0.19 -0.03" size="0.002 0.06 0.07" mat="body_yellow"/>
    <xacro:vbox n="bump_s2" xyz="0.4305 0.07 -0.03" size="0.002 0.06 0.07" mat="body_yellow"/>
    <xacro:vbox n="bump_s3" xyz="0.4305 -0.07 -0.03" size="0.002 0.06 0.07" mat="body_yellow"/>
    <xacro:vbox n="bump_s4" xyz="0.4305 -0.19 -0.03" size="0.002 0.06 0.07" mat="body_yellow"/>
    <xacro:vbox n="head_l" xyz="0.4305 0.235 0.03" size="0.004 0.035 0.025" mat="lamp"/>
    <xacro:vbox n="head_r" xyz="0.4305 -0.235 0.03" size="0.004 0.035 0.025" mat="lamp"/>
    <!-- deck, battery hood and E-stop (all below the lidar plane) -->
    <xacro:vbox n="deck" xyz="0.10 0 0.103" size="0.40 0.46 0.006" mat="graphite"/>
    <xacro:vbox n="hood" xyz="0.19 0 0.13" size="0.14 0.30 0.05" mat="body_yellow"/>
    <xacro:vcyl n="estop_base" xyz="0.19 0.10 0.162" r="0.026" l="0.012" mat="body_yellow"/>
    <xacro:vcyl n="estop" xyz="0.19 0.10 0.172" r="0.018" l="0.016" mat="red"/>

    <!-- ===== Industrial upgrade (visual only, no collision, no mass) =====
         Autonomous truck: no seat or steering column. Instead: overhead guard, beacon, status bar,
         corner safety scanners, side E-stops, reflective tape, ID plate, charge contacts.
         The guard posts sit inside scan_filter.yaml's body_box (x -0.45..0.30, y +-0.35). -->
    <!-- overhead guard: 4 posts + open roof grille (roof at +0.80 = 0.92 m above floor, behind the camera) -->
    <xacro:vbox n="guard_post_rl" xyz="-0.34  0.22 0.45" size="0.03 0.03 0.70" mat="body_yellow"/>
    <xacro:vbox n="guard_post_rr" xyz="-0.34 -0.22 0.45" size="0.03 0.03 0.70" mat="body_yellow"/>
    <xacro:vbox n="guard_post_fl" xyz=" 0.14  0.22 0.45" size="0.03 0.03 0.70" mat="body_yellow"/>
    <xacro:vbox n="guard_post_fr" xyz=" 0.14 -0.22 0.45" size="0.03 0.03 0.70" mat="body_yellow"/>
    <xacro:vbox n="guard_bar_f" xyz=" 0.165 0 0.80" size="0.03 0.50 0.02" mat="body_yellow"/>
    <xacro:vbox n="guard_bar_r" xyz="-0.365 0 0.80" size="0.03 0.50 0.02" mat="body_yellow"/>
    <xacro:vbox n="guard_bar_l" xyz="-0.10  0.235 0.80" size="0.56 0.03 0.02" mat="body_yellow"/>
    <xacro:vbox n="guard_bar_ri" xyz="-0.10 -0.235 0.80" size="0.56 0.03 0.02" mat="body_yellow"/>
    <xacro:vbox n="guard_slat_1" xyz="-0.30 0 0.802" size="0.02 0.46 0.012" mat="graphite"/>
    <xacro:vbox n="guard_slat_2" xyz="-0.20 0 0.802" size="0.02 0.46 0.012" mat="graphite"/>
    <xacro:vbox n="guard_slat_3" xyz="-0.10 0 0.802" size="0.02 0.46 0.012" mat="graphite"/>
    <xacro:vbox n="guard_slat_4" xyz=" 0.00 0 0.802" size="0.02 0.46 0.012" mat="graphite"/>
    <xacro:vbox n="guard_slat_5" xyz=" 0.10 0 0.802" size="0.02 0.46 0.012" mat="graphite"/>
    <!-- amber strobe beacon on the roof -->
    <xacro:vcyl n="beacon_base" xyz="-0.30 0 0.82" r="0.032" l="0.02" mat="graphite"/>
    <xacro:vcyl n="beacon_lens" xyz="-0.30 0 0.855" r="0.026" l="0.05" mat="amber"/>
    <xacro:vsph n="beacon_cap" xyz="-0.30 0 0.88" r="0.026" mat="amber"/>
    <!-- red / amber / green status bar on the front and rear roof bars -->
    <xacro:vbox n="status_f_red"   xyz="0.1815  0.07 0.80" size="0.004 0.05 0.014" mat="red"/>
    <xacro:vbox n="status_f_amber" xyz="0.1815  0.00 0.80" size="0.004 0.05 0.014" mat="amber"/>
    <xacro:vbox n="status_f_green" xyz="0.1815 -0.07 0.80" size="0.004 0.05 0.014" mat="signal_green"/>
    <xacro:vbox n="status_r_red"   xyz="-0.3815  0.07 0.80" size="0.004 0.05 0.014" mat="red"/>
    <xacro:vbox n="status_r_amber" xyz="-0.3815  0.00 0.80" size="0.004 0.05 0.014" mat="amber"/>
    <xacro:vbox n="status_r_green" xyz="-0.3815 -0.07 0.80" size="0.004 0.05 0.014" mat="signal_green"/>
    <!-- blue pedestrian warning spots on the front guard posts -->
    <xacro:vbox n="blue_spot_l" xyz="0.158  0.22 0.30" size="0.014 0.04 0.03" mat="safety_blue"/>
    <xacro:vbox n="blue_spot_r" xyz="0.158 -0.22 0.30" size="0.014 0.04 0.03" mat="safety_blue"/>
    <!-- corner safety laser scanners (visual only; they stay below the lidar plane) -->
    <xacro:vbox n="scan_fl" xyz=" 0.38  0.262 -0.02" size="0.08 0.05 0.06" mat="graphite"/>
    <xacro:vbox n="scan_fr" xyz=" 0.38 -0.262 -0.02" size="0.08 0.05 0.06" mat="graphite"/>
    <xacro:vbox n="scan_rl" xyz="-0.36  0.262 -0.02" size="0.08 0.05 0.06" mat="graphite"/>
    <xacro:vbox n="scan_rr" xyz="-0.36 -0.262 -0.02" size="0.08 0.05 0.06" mat="graphite"/>
    <xacro:vbox n="scan_fl_cap" xyz=" 0.38  0.262 0.014" size="0.082 0.052 0.008" mat="body_yellow"/>
    <xacro:vbox n="scan_fr_cap" xyz=" 0.38 -0.262 0.014" size="0.082 0.052 0.008" mat="body_yellow"/>
    <xacro:vbox n="scan_rl_cap" xyz="-0.36  0.262 0.014" size="0.082 0.052 0.008" mat="body_yellow"/>
    <xacro:vbox n="scan_rr_cap" xyz="-0.36 -0.262 0.014" size="0.082 0.052 0.008" mat="body_yellow"/>
    <xacro:vbox n="scan_fl_win" xyz=" 0.4215  0.262 -0.02" size="0.003 0.04 0.02" mat="black"/>
    <xacro:vbox n="scan_fr_win" xyz=" 0.4215 -0.262 -0.02" size="0.003 0.04 0.02" mat="black"/>
    <xacro:vbox n="scan_rl_win" xyz="-0.4015  0.262 -0.02" size="0.003 0.04 0.02" mat="black"/>
    <xacro:vbox n="scan_rr_win" xyz="-0.4015 -0.262 -0.02" size="0.003 0.04 0.02" mat="black"/>
    <!-- side E-stops (yellow collar, red mushroom) -->
    <xacro:vcyl n="estop_l_base" xyz="0.0  0.2545 0.04" r="0.03" l="0.008" mat="body_yellow" rpy="${pi/2} 0 0"/>
    <xacro:vcyl n="estop_l"      xyz="0.0  0.2635 0.04" r="0.02" l="0.016" mat="red" rpy="${pi/2} 0 0"/>
    <xacro:vcyl n="estop_r_base" xyz="0.0 -0.2545 0.04" r="0.03" l="0.008" mat="body_yellow" rpy="${pi/2} 0 0"/>
    <xacro:vcyl n="estop_r"      xyz="0.0 -0.2635 0.04" r="0.02" l="0.016" mat="red" rpy="${pi/2} 0 0"/>
    <!-- reflective side tape, ID plate on the battery hood, automatic-charging contacts at the rear -->
    <xacro:vbox n="tape_l" xyz="-0.02  0.2525 -0.045" size="0.50 0.002 0.012" mat="white"/>
    <xacro:vbox n="tape_r" xyz="-0.02 -0.2525 -0.045" size="0.50 0.002 0.012" mat="white"/>
    <xacro:vbox n="id_plate"  xyz="0.19 -0.03 0.1565" size="0.07 0.12 0.002" mat="white"/>
    <xacro:vbox n="id_stripe" xyz="0.19 -0.03 0.1580" size="0.02 0.12 0.001" mat="amber"/>
    <xacro:vbox n="charge_pos" xyz="-0.402  0.06 0.0" size="0.004 0.05 0.03" mat="copper"/>
    <xacro:vbox n="charge_neg" xyz="-0.402 -0.06 0.0" size="0.004 0.05 0.03" mat="copper"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheels -->
  <xacro:macro name="drive_wheel" params="name y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="dark"/>
      </visual>
      <visual name="hub">
        <origin xyz="0 ${(1 if y > 0 else -1) * 0.002} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.06" length="${wheel_w + 0.006}"/></geometry>
        <material name="steel"/>
      </visual>
      <visual name="hub_cap">
        <origin xyz="0 ${(1 if y > 0 else -1) * 0.027} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.025" length="0.006"/></geometry>
        <material name="body_yellow"/>
      </visual>
      <visual name="bolt_0">
        <origin xyz="0.04 ${(1 if y > 0 else -1) * 0.031} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.007" length="0.004"/></geometry>
        <material name="black"/>
      </visual>
      <visual name="bolt_1">
        <origin xyz="-0.04 ${(1 if y > 0 else -1) * 0.031} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.007" length="0.004"/></geometry>
        <material name="black"/>
      </visual>
      <visual name="bolt_2">
        <origin xyz="0 ${(1 if y > 0 else -1) * 0.031} 0.04" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.007" length="0.004"/></geometry>
        <material name="black"/>
      </visual>
      <visual name="bolt_3">
        <origin xyz="0 ${(1 if y > 0 else -1) * 0.031} -0.04" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.007" length="0.004"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${pi/2} 0 0"/>
        <mass value="${wheel_m}"/>
        <inertia ixx="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12.0}" ixy="0" ixz="0"
                 iyy="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12.0}" iyz="0"
                 izz="${wheel_m*wheel_r*wheel_r/2.0}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <!-- base_link sits 0.12 m above ground, wheel centre sits at wheel_r (0.10 m) -->
      <origin xyz="${wheel_x} ${y} -0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel name="left"  y="${ wheel_sep/2}"/>
  <xacro:drive_wheel name="right" y="${-wheel_sep/2}"/>

  <!-- Front and rear casters (frictionless spheres) keep the body level -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual><geometry><sphere radius="0.04"/></geometry><material name="dark"/></visual>
      <collision><geometry><sphere radius="0.04"/></geometry></collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <!-- sphere radius 0.04 touches the ground when base_link is 0.12 m up -->
      <origin xyz="${x} 0 -0.08"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="rear"  x="-0.32"/>
  <xacro:caster name="front" x="0.30"/>

  <!-- LiDAR on a short post at the rear. Scan plane is 0.34 m above ground:
       above the idle forks (top at 0.27 m) and low enough to hit pallet legs and rack panels.
       The mast shadows about +-14 degrees straight ahead. -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.075"/>
      <geometry><cylinder radius="0.015" length="0.10"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.25 0 0.22"/>
  </joint>

  <!-- Camera on the front face of the mast, 0.80 m above ground, looking straight ahead.
       That is above a pallet carried at 0.15 m lift (top at about 0.55 m) so the rack marker stays
       visible, and the carriage only reaches camera height at about 0.45 m lift. -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <!-- sun visor and lens ring; everything stays within 0.03 m of the sensor (camera near clip is 0.05 m) -->
    <xacro:vbox n="visor" xyz="0.01 0 0.0175" size="0.04 0.09 0.004" mat="graphite"/>
    <xacro:vcyl n="lens_ring" xyz="0.018 0 0" r="0.012" l="0.01" mat="black" rpy="0 ${pi/2} 0"/>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.43 0 0.68"/>
  </joint>
  <!-- Optical frame: z forward, x right, y down -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- IMU at the body centre -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Mast (fixed) -->
  <link name="mast_link">
    <!-- two C-channel rails, cross beams, hydraulic lift cylinder (visual only; collision is one box) -->
    <xacro:vbox n="rail_l" xyz="0 0.14 ${mast_h/2}" size="0.07 0.05 ${mast_h}" mat="graphite"/>
    <xacro:vbox n="rail_r" xyz="0 -0.14 ${mast_h/2}" size="0.07 0.05 ${mast_h}" mat="graphite"/>
    <xacro:vbox n="rail_l_face" xyz="0.03 0.14 ${mast_h/2}" size="0.012 0.04 ${mast_h - 0.02}" mat="steel"/>
    <xacro:vbox n="rail_r_face" xyz="0.03 -0.14 ${mast_h/2}" size="0.012 0.04 ${mast_h - 0.02}" mat="steel"/>
    <xacro:vbox n="mast_top" xyz="0 0 ${mast_h - 0.02}" size="0.07 0.33 0.04" mat="graphite"/>
    <xacro:vbox n="mast_mid" xyz="0 0 0.45" size="0.05 0.33 0.03" mat="graphite"/>
    <xacro:vbox n="mast_foot" xyz="0 0 0.03" size="0.09 0.33 0.06" mat="body_yellow"/>
    <xacro:vcyl n="lift_cyl" xyz="-0.02 0 0.30" r="0.028" l="0.50" mat="graphite"/>
    <xacro:vcyl n="lift_rod" xyz="-0.02 0 0.68" r="0.013" l="0.30" mat="chrome"/>
    <!-- lift chains, hydraulic hoses and hazard stripes on the mast foot (all within the mast footprint) -->
    <xacro:vbox n="chain_l" xyz="-0.03  0.06 0.66" size="0.006 0.012 0.42" mat="steel"/>
    <xacro:vbox n="chain_r" xyz="-0.03 -0.06 0.66" size="0.006 0.012 0.42" mat="steel"/>
    <xacro:vcyl n="hose_l" xyz="-0.06  0.035 0.30" r="0.006" l="0.50" mat="black"/>
    <xacro:vcyl n="hose_r" xyz="-0.06 -0.035 0.30" r="0.006" l="0.50" mat="black"/>
    <xacro:vbox n="foot_stripe_1" xyz="0.046  0.10 0.03" size="0.002 0.04 0.05" mat="black"/>
    <xacro:vbox n="foot_stripe_2" xyz="0.046  0.00 0.03" size="0.002 0.04 0.05" mat="black"/>
    <xacro:vbox n="foot_stripe_3" xyz="0.046 -0.10 0.03" size="0.002 0.04 0.05" mat="black"/>
    <collision>
      <origin xyz="0 0 ${mast_h/2}"/>
      <geometry><box size="0.05 0.30 ${mast_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${mast_h/2}"/>
      <mass value="3.0"/>
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${mast_x - 0.05} 0 ${body_h/2}"/>
  </joint>

  <!-- Carriage slides up the mast -->
  <link name="carriage_link">
    <visual>
      <geometry><box size="0.04 0.40 0.12"/></geometry>
      <material name="graphite"/>
    </visual>
    <xacro:vbox n="car_top" xyz="0.005 0 0.05" size="0.05 0.40 0.025" mat="body_yellow"/>
    <xacro:vbox n="car_bot" xyz="0.005 0 -0.05" size="0.05 0.40 0.025" mat="body_yellow"/>
    <!-- load backrest, 0.20 m high: low enough to stay under the camera (0.80 m) up to about 0.30 m lift -->
    <xacro:vbox n="br_v1" xyz="0.0 0.19 0.16" size="0.03 0.025 0.20" mat="body_yellow"/>
    <xacro:vbox n="br_v2" xyz="0.0 0.15 0.16" size="0.02 0.015 0.20" mat="graphite"/>
    <xacro:vbox n="br_v3" xyz="0.0 0.06 0.16" size="0.02 0.015 0.20" mat="graphite"/>
    <xacro:vbox n="br_v4" xyz="0.0 -0.06 0.16" size="0.02 0.015 0.20" mat="graphite"/>
    <xacro:vbox n="br_v5" xyz="0.0 -0.15 0.16" size="0.02 0.015 0.20" mat="graphite"/>
    <xacro:vbox n="br_v6" xyz="0.0 -0.19 0.16" size="0.03 0.025 0.20" mat="body_yellow"/>
    <xacro:vbox n="br_top" xyz="0.0 0 0.265" size="0.03 0.40 0.025" mat="body_yellow"/>
    <xacro:vbox n="br_mid" xyz="0.0 0 0.17" size="0.02 0.36 0.018" mat="graphite"/>
    <collision>
      <geometry><box size="0.04 0.40 0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="fork_lift_joint" type="prismatic">
    <parent link="mast_link"/>
    <child link="carriage_link"/>
    <origin xyz="0.045 0 0.08"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="${fork_lift_max}" effort="500.0" velocity="0.2"/>
    <dynamics damping="50.0" friction="1.0"/>
  </joint>

  <!-- Two fork tines fixed to the carriage -->
  <xacro:macro name="fork" params="name y">
    <link name="${name}_fork">
      <xacro:vbox n="blade" xyz="0.225 0 0" size="0.45 0.07 0.03" mat="steel"/>
      <xacro:vbox n="tip" xyz="0.525 0 -0.007" size="0.15 0.07 0.016" mat="steel"/>
      <xacro:vbox n="shank" xyz="0.015 0 0.09" size="0.03 0.07 0.21" mat="steel"/>
      <collision>
        <origin xyz="${fork_len/2} 0 0"/>
        <geometry><box size="${fork_len} 0.07 0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${fork_len/2} 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
      </inertial>
    </link>
    <joint name="${name}_fork_joint" type="fixed">
      <parent link="carriage_link"/>
      <child link="${name}_fork"/>
      <origin xyz="0.02 ${y} -0.045"/>
    </joint>
    <gazebo reference="${name}_fork">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:fork name="left"  y="0.14"/>
  <xacro:fork name="right" y="-0.14"/>

  <!-- ================= Ignition Gazebo (Fortress, `ign gazebo`) =================
       Loaded by ros_gz_sim `create -topic robot_description`. sdformat converts this URDF to SDF and
       lumps fixed joints, so every sensor sets <ignition_frame_id> to keep its ROS frame name.
       Topics below are Ignition topics; sim.launch.py bridges them to ROS 2. -->

  <!-- Differential drive: /cmd_vel in, /odom out, odom->base_footprint on /model/forklift/tf -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/model/forklift/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Wheel and fork joint states: /world/warehouse/model/forklift/joint_state (bridged to /joint_states) -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

  <!-- Fork lift: std_msgs/Float64 target height in metres on /fork/cmd_pos (PID force control).
       The docking node ramps the target; a step command makes the fork jump. -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>fork_lift_joint</joint_name>
      <topic>/fork/cmd_pos</topic>
      <p_gain>5000</p_gain>
      <i_gain>500</i_gain>
      <d_gain>50</d_gain>
      <i_max>300</i_max>
      <i_min>-300</i_min>
      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR: /scan -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera: /camera/front/image_raw and /camera/front/camera_info -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>camera/front/image_raw</topic>
      <ignition_frame_id>camera_optical_link</ignition_frame_id>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU: /imu/data -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu/data</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <!-- MEMS-grade noise so the data looks like a real IMU (values from a typical industrial part) -->
      <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
