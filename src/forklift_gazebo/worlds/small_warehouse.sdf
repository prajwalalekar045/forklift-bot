      <static>true</static>
      <link name="link">
        <visual name="mark_000"><cast_shadows>false</cast_shadows><pose>-4.4500 9.1750 0.0365 0 0 0</pose><geometry><box><size>0.0700 1.9500 0.004</size></box></geometry><material><ambient>0.95 0.75 0.0 1</ambient><diffuse>0.95 0.75 0.0 1</diffuse><specular>0 0 0 1</specular></material></visual>
